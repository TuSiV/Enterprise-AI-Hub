{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Enterprise AI Hub",
  "version": "0.1.0",
  "identifier": "com.enterprise-aihub.desktop",
  "build": {
    "frontendDist": "../../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd ../../../web && npm run dev",
    "beforeBuildCommand": "cd ../../../web && npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "icon": [],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://updates.example.com/aihub/{{target}}/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlGRDYxNEE1QUM2MEU2RkQKUldUOTVtQ3NwUlRXbjJlVTBwWUZwZnRiZVk5d21HWUlUNnBOU1l0Ymd2MStXeXl4ZCthUzhxMVYK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}