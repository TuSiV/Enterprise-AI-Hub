{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "../../../web/dist/": "web/dist/"
    },
    "targets": [
      "nsis",
      "msi"
    ],
    "windows": {
      "wix": {
        "language": ["zh-CN", "en-US"]
      },
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true
      }
    }
  }
}
